#include<iostream>
using namespace std;
int main() {
double num1 , num2;
char op;
cout << "enter first number :";
cin >> num1;
cout<< "enter operation (+, -, %, *)";
cin >> op;
cout <<" enter second number";
cin >> num2;
switch (op){
case '+' :
cout << "result ="<<num1 + num2;
break;
case '-':
cout << "result =" << num1-num2;
break;
case '*':
cout << "result =" << num1*num2;
break;
case '/':
cout << "result =" << num1/num2;
else 
cout << "cannot divide by zero";
break;
default:
cout << "invalid operation";
}}
break;
